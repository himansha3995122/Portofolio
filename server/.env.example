# ==========================================================
# CHANGE ME before deploying — copy this file to ".env" and
# fill in real values. ".env" itself is gitignored on purpose.
# ==========================================================

PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The password you'll type at yourdomain.com/admin to edit the site.
# This is compared server-side only — it is never sent to the browser
# except at the moment you log in over HTTPS.
ADMIN_PASSWORD=replace-with-your-admin-password

# Only needed in local development, where the Vite dev server (client)
# runs on a different port than this API. Not used in production once
# Express serves the built client itself (see src/index.js).
CLIENT_ORIGIN=http://localhost:5173
